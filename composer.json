{
	"name": "skachcz/imokutr3",
	"type": "library",
	"version": "2.0.0",
	"description": "PHP image thumbnailer created with primary use for Nette framework, but also usable as a standalone PHP library",
	"keywords": [
		"nette",
		"images",
		"thumbnails"
	],
	"license": [
		"MIT"
	],
	"authors": [
		{
			"name": "Vladimir Skach"
		}
	],
	"support": {
		"issues": "https://github.com/skachcz/imokutr/issues"
	},
	"require": {
		"php": ">=8.4",
		"ext-gd": "*"
	},
	"require-dev": {
		"nette/di": "^3.2",
		"latte/latte": "^3.0",
		"tracy/tracy": "^2.10",
		"phpstan/phpstan": "^2.0",
		"phpstan/phpstan-nette": "^2.0",
		"phpstan/extension-installer": "^1.4",
		"squizlabs/php_codesniffer": "^3.11",
		"slevomat/coding-standard": "^8.15"
	},
	"suggest": {
		"nette/di": "Needed to register the Nette DI extension",
		"latte/latte": "Needed for the imoUrl filter and the imoTag tag"
	},
	"autoload": {
		"classmap": ["src/"]
	},
	"config": {
		"allow-plugins": {
			"phpstan/extension-installer": true,
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
